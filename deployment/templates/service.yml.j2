apiVersion: v1
kind: Service
metadata:
  name: {{ app.application_name }}
  namespace: {{ app.namespace }}
  labels:
    app.kubernetes.io/name: {{ app.application_name }}
    app.kubernetes.io/managed-by: ansible
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: {{ app.application_name }}
  ports:
    - name: app
      port: {{ app.service_port | int }}
      targetPort: {{ app.container_port | int }}
